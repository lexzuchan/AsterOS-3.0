{
  "name": "vixenn",
  "version": "0.2.0",
  "description": "Vixenn desktop browser",
  "main": "main.js",
  "author": "Vixenn",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "check": "node --check main.js && node --check protection.js && node --check preload.js && node --check ui/icons.js && node --check ui/app.js && node --test tests/*.test.js"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.vixenn.browser",
    "productName": "Vixenn",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "navigation.js",
      "ui/**/*",
      "package.json",
      "protection.js",
      "filters/**/*"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "Vixenn-${version}-Windows.exe"
    }
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.20.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
